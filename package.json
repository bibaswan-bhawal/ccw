{
  "name": "ccw",
  "version": "0.1.0",
  "description": "Claude Code Worktree — manage git worktrees with persistent Claude Code sessions and Jira integration",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Bibaswan Bhawal",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibaswan-bhawal/ccw.git"
  },
  "bin": {
    "ccw": "./bin/ccw"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/ccw --target=bun",
    "build:macos-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/ccw-macos-arm64",
    "build:macos-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/ccw-macos-x64",
    "build:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/ccw-linux-x64",
    "build:all": "bun run build:macos-arm64 && bun run build:macos-x64 && bun run build:linux-x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml}\""
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.6",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
